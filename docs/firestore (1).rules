rules_version = '2';

// Regras do Firestore para o app Sala de Reunião (Grupo GPS).
// Todos podem ler a agenda, criar reuniões válidas e cancelar (apagar).
// Não é possível editar uma reunião depois de criada.
service cloud.firestore {
  match /databases/{database}/documents {
    match /reunioes/{id} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['date','start','end','setor','assunto','createdAt'])
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.start is int
        && request.resource.data.end is int
        && request.resource.data.start >= 480
        && request.resource.data.end <= 1080
        && request.resource.data.end > request.resource.data.start
        && request.resource.data.setor is string
        && request.resource.data.setor.size() > 0
        && request.resource.data.setor.size() <= 40
        && request.resource.data.assunto is string
        && request.resource.data.assunto.size() <= 80
        && request.resource.data.createdAt is string;

      allow update: if false;
      allow delete: if true;
    }
  }
}
